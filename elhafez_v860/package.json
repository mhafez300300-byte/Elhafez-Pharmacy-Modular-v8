{
  "name": "elhafez-pharmacy-clean-v8",
  "version": "8.8.0",
  "private": true,
  "type": "module",
  "description": "Elhafez Pharmacy v8 — clean TypeScript Modular Monolith rebuilt from scratch",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "tsc -p web/tsconfig.json && cp web/styles/app.css public/assets/app.css",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "rm -rf .test-dist && tsc -p tsconfig.test.json && node --test .test-dist/tests/*.test.js",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:clean-room": "node scripts/check-clean-room.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm run check:db-ownership && npm run check:clean-room && npm test",
    "start": "node dist/app/server.js",
    "check:db-ownership": "node scripts/check-database-ownership.mjs",
    "test:postgres": "npm run build:server && node scripts/postgres-integration.mjs",
    "preflight": "npm run check && npm run build",
    "test:performance": "npm run build:server && node scripts/performance-drill.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "@types/express": "4.17.23",
    "@types/node": "22.15.30",
    "@types/pg": "8.15.5"
  }
}
