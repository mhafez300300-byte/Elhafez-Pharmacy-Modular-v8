NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elhafez_pharmacy_v8
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BACKUP_SECRET=replace-with-a-stable-backup-secret-at-least-32-characters
SESSION_HOURS=12
ALLOW_STANDALONE_SETUP=true
OWNER_CENTER_URL=
OWNER_PRODUCT_CODE=PHARMAFLOW

DRUG_MASTER_AUTO_SEED=true
DRUG_MASTER_SEED_FILE=data/drug-master-egypt-reference.csv.gz

# Background operational workers
ALERT_REFRESH_MINUTES=15
SECURITY_CLEANUP_HOURS=6

# Test-only disposable PostgreSQL database used by npm run test:postgres
# Never point this at production.
INTEGRATION_DATABASE_URL=
