PORT=3000
NODE_ENV=production
DATABASE_URL=postgresql://pharmaflow:change_me@postgres:5432/pharmaflow
APP_SECRET=replace-with-at-least-32-random-characters
# Optional but strongly recommended in production: protects first-time tenant claim
SETUP_KEY=replace-with-a-random-first-setup-code
SESSION_HOURS=12
TRUST_PROXY=1
BACKUP_DIR=/app/backups
BACKUP_SECRET=replace-with-a-stable-backup-encryption-secret
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_UPLOAD_URL=
BACKUP_UPLOAD_TOKEN=
RELEASE_CHANNEL=stable
AUTO_UPDATE=false
UPDATE_MANIFEST_URL=
UPDATE_DEPLOY_WEBHOOK_URL=
UPDATE_SIGNING_SECRET=
LICENSE_SERVER_URL=
LICENSE_KEY=
LICENSE_GRACE_HOURS=72
LICENSE_CHECK_MINUTES=15
INSTANCE_NAME=customer-pharmacy-slug
VENDOR_TELEMETRY_URL=
VENDOR_TELEMETRY_TOKEN=
# Egyptian Tax Authority eReceipt Integration Toolkit / adapter
ETA_ENABLED=false
ETA_TOOLKIT_URL=
ETA_SUBMIT_PATH=/api/receipts/submit
ETA_STATUS_PATH=/api/receipts/status
ETA_CLIENT_ID=
ETA_CLIENT_SECRET=
# Egyptian Pharmaceutical Track & Trace (EPTTS/Masar) adapter
EPTTS_ENABLED=false
EPTTS_ENDPOINT=
EPTTS_AUTH_TOKEN=
# Optional trusted central catalog/rules feed
CATALOG_FEED_URL=
CLINICAL_RULES_FEED_URL=

# Optional central Vendor Service
VENDOR_PORT=3100
VENDOR_DATABASE_URL=
VENDOR_ADMIN_TOKEN=
VENDOR_TELEMETRY_TOKEN=

# Elhafez Owner Control Center — universal activation
OWNER_CENTER_URL=https://elhafez-technology-owner-production.up.railway.app
OWNER_CUSTOMER_NAME=
OWNER_CUSTOMER_CODE=
OWNER_PRODUCT_CODE=PHARMAFLOW
ALLOW_STANDALONE_SETUP=false

# Optional offline fallback only; normal source is Owner Center /api/branding
PROVIDER_BRAND_NAME=Elhafez Technology
PROVIDER_BRAND_PHONE=
PROVIDER_BRAND_WHATSAPP=
PROVIDER_BRAND_EMAIL=
PROVIDER_BRAND_WEBSITE=
PROVIDER_BRAND_EXTRA=
