<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"
            android:importantForAutofill="yes" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:max="100" />

    <ScrollView
        android:id="@+id/activationPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@drawable/activation_background"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="640dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:background="@drawable/activation_card"
                android:padding="28dp">

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="112dp"
                    android:src="@mipmap/ic_launcher"
                    android:contentDescription="Elhafez Pharmacy"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Elhafez Pharmacy"
                    android:textColor="#12373D"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="نظام واحد لكل الصيدليات — اربطه بشركتك بكود التفعيل"
                    android:textColor="#6A7A7D"
                    android:textSize="14sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="كود تفعيل الشركة"
                    android:textColor="#153A40"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="right" />

                <EditText
                    android:id="@+id/activationCode"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/activation_input"
                    android:hint="PH-XXXXXXXX"
                    android:gravity="center"
                    android:inputType="textCapCharacters"
                    android:maxLength="16"
                    android:singleLine="true"
                    android:textColor="#12373D"
                    android:textColorHint="#9AA7A9"
                    android:textSize="18sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/activationError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:textColor="#B33C31"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/activationButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/activation_button"
                    android:text="تفعيل وفتح الصيدلية"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/activationProgress"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="الكود يصدر من Owner Control Center بعد إنشاء الشركة والاشتراك وتجهيز النسخة."
                    android:textColor="#849194"
                    android:textSize="12sp"
                    android:gravity="center" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
